# ===========================================================================
# OpenCode dotfiles — required secrets
# Copy this file to `secrets.env` and fill in your real keys.
# `secrets.env` is git-ignored — never commit real keys.
#
# The setup script reads these and exports them as environment variables so
# that OpenCode's `{env:VAR}` placeholders in opencode.json resolve correctly.
# ===========================================================================

# MCP server: needmcp.com
NEEDMCP_API_KEY=

# Provider: OpenAgentic (openagentic.id)
OPENAGENTIC_API_KEY=

# Provider: YogatheDev
YOGATHEDEV_API_KEY=

# Provider: Moyra AI
MOYRA_API_KEY=

# Provider: SrByte Router
SRBYTE_API_KEY=

# Provider: 9Router (local proxy on port 20128)
NINEROUTER_API_KEY=
