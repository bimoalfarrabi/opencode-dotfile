{
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "context-mode",
    "oh-my-opencode-slim"
  ],
  "skills": {
    "paths": [
      "{{OPEN_DESIGN_DIR}}/skills",
      "{{OPEN_DESIGN_DIR}}/design-systems",
      "{{AGENTS_SKILLS}}"
    ]
  },
  "mcp": {
    "headroom": {
      "enabled": false,
      "type": "local",
      "command": [
        "{{HEADROOM_BIN}}",
        "mcp",
        "serve"
      ]
    },
    "open-design": {
      "type": "local",
      "command": [
        "node",
        "{{OPEN_DESIGN_DIR}}/apps/daemon/dist/cli.js",
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:34215"
      ]
    },
    "needmcp": {
      "type": "remote",
      "url": "https://needmcp.com/mcp",
      "enabled": true,
      "headers": {
        "X-API-Key": "{env:NEEDMCP_API_KEY}"
      }
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
